# Copy to .env.development.local for explicit development-only mock mode.
# Endpoint paths already include /v1. Use an API origin without /v1 here.
VITE_API_BASE_URL=http://127.0.0.1:3000
VITE_USE_MOCKS=true
VITE_DEFAULT_REGION=ap-south-1
VITE_COGNITO_REGION=ap-south-1
# Real login needs public Cognito configuration and matching OAuth redirects.
# The current backend template does not yet provision managed-login OAuth.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_FEATURES=
